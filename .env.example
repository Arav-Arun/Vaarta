# ---------------------------------------------------------------------------
# Required: world and lesson generation
# ---------------------------------------------------------------------------
# Everything Vaarta paints and every turn it scores runs through this key.
# Without it the app still loads, but building a world returns a clear error
# naming the missing key rather than "please try again".
GEMINI_API_KEY=your_key_here

# ---------------------------------------------------------------------------
# Required for speech: the NPC voices
# ---------------------------------------------------------------------------
# Sarvam speaks all six languages in the catalogue. Without this key the
# browser's own speech engine is used instead, which is noticeably worse at
# Indian languages but keeps the game playable.
SARVAM_API_KEY=your_sarvam_key_here
SARVAM_TTS_MODEL=bulbul:v3

# ---------------------------------------------------------------------------
# Optional: model overrides (defaults shown)
# ---------------------------------------------------------------------------
# Do not downgrade these to a 2.5 model. Those are still listed by the API but
# are gated for keys issued recently, and they 404 at call time rather than at
# startup.
# TEXT_MODEL plans worlds, reads painted frames, and scores spoken turns.
TEXT_MODEL=gemini-3.6-flash
# IMAGE_MODEL paints every screen, room, character and ending.
IMAGE_MODEL=gemini-3.1-flash-image

# ---------------------------------------------------------------------------
# Required for accounts and sign-in
# ---------------------------------------------------------------------------
# Vaarta requires a signed-in learner. proxy.ts gates the dashboard, every
# world, and every generation endpoint because the API routes are what cost
# money to call. Configure both values before deploying; an incomplete setup
# shows the login screen with a clear configuration error instead of opening
# the dashboard without authentication.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# ---------------------------------------------------------------------------
# Required to pre-generate starter worlds
# ---------------------------------------------------------------------------
# `npm run warm` is a machine with no session to offer, so it presents this in
# an x-vaarta-warm header instead. Set any long random string; the warmer reads
# it straight out of this file. An unset or empty value is never a valid
# bypass, so leaving it blank simply means the warmer gets 401 on every call.
VAARTA_WARM_TOKEN=

# ---------------------------------------------------------------------------
# Required in production: canonical public URL
# ---------------------------------------------------------------------------
# Used for social-card URLs and the Google OAuth return URL. Set it to the
# exact deployed origin (no trailing slash), then add
# `https://your-domain.example/auth/callback` under Supabase Auth > URL
# Configuration > Redirect URLs and set the same origin as Supabase's Site URL.
# `NEXT_PUBLIC_*` values are embedded in the browser build, so redeploy after
# changing this value. Local development can use http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# ---------------------------------------------------------------------------
# Optional: product analytics
# ---------------------------------------------------------------------------
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
