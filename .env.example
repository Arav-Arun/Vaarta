# Required — AI
GEMINI_API_KEY=your_key_here
SARVAM_API_KEY=your_sarvam_key_here

# Optional — model overrides (defaults shown)
TEXT_MODEL=gemini-3.6-flash
IMAGE_MODEL=gemini-3.1-flash-image
SARVAM_TTS_MODEL=bulbul:v3

# Required — Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here

# Required in production — canonical URL for OAuth redirects
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Optional — starter world pre-warmer auth token
VAARTA_WARM_TOKEN=

# Optional — enable custom world generation (disabled by default to manage API costs)
ENABLE_CUSTOM_WORLDS=false
NEXT_PUBLIC_ENABLE_CUSTOM_WORLDS=false

# Optional — PostHog analytics
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
