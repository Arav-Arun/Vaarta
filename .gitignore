# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
**/.DS_Store
Thumbs.db
*.pem

# AI agent tooling and generated skill packs, never belongs in the repo
.agents/
.claude/
.claude*/
.cursor/
.cursorignore
.hallmark/
.aider*
.windsurf/
skills-lock.json
CLAUDE.md
AGENTS.md
GEMINI.md
.github/copilot-instructions.md

# Release notes and working-session artefacts
*.md
HANDOFF.md
NOTES.md
TODO.md
SCRATCH.md
*.local.md
scratchpad/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# Generated TypeScript declarations
*.tsbuildinfo
next-env.d.ts

# allow the env template while keeping real env files ignored
!.env.example
